# =====================================================================
# SERA PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!
# =====================================================================

# ─── DATABASE ──────────────────────────────────────────────────────────
# SQLite (development - no installation needed):
DATABASE_URL=sqlite+aiosqlite:///./sera_db.sqlite3
#
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/sera_db

# ─── AI / LLM ─────────────────────────────────────────────────────────
LLM_PROVIDER=openai
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct
AI_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── ENTITY AI LAYER ──────────────────────────────────────────────────
# mock = development (no ML, synthetic data)
# live = production (real ML pipeline, requires GPU)
ENTITY_MODE=mock
USE_NOETHER=false
USE_PRETRAINED_CIFN=false
ENTITY_API_URL=http://localhost:8000

# ─── API KEYS & AUTHENTICATION ──────────────────────────────────────
DEMO_API_KEY=sera-demo-2026
API_KEYS={"sera-demo-2026":"default_demo"}

# JWT Authentication (change in production!)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── DATA INGESTION ──────────────────────────────────────────────────
USE_REAL_DATA=false                 # true = fetch real data from APIs

# SEC EDGAR API (for financial data)
SEC_IDENTITY_EMAIL=your-email@example.com

# GitHub API
GITHUB_TOKEN=your_github_token_here

# AIS Maritime Data
AIS_STREAM_KEY=your_ais_stream_key_here

# Apify Web Scraping
APIFY_TOKEN=your_apify_token_here

# US Government Data.gov API
DATAGOV_IN_API_KEY=

# ─── CENSYS (Internet Reconnaissance) ──────────────────────────────
CENSYS_API_ID=your-censys-api-id
CENSYS_API_SECRET=your-censys-api-secret

# ─── REDIS (Caching) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── NEO4J (Graph Database) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=SeraGraphPass2026!

# ─── SERVER ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─── SECURITY AGENT ──────────────────────────────────────────────────
KALI_IMAGE=custom-kali:latest
ZERO_INPUT_ENABLED=false
NETWORK_INTERFACE=eth0
EXPLOIT_SERVER_IP=192.168.1.100

# ─── STYX PRIME DETECTION ────────────────────────────────────────────
STYX_ENABLED=false
STYX_NTP_MONITOR_TIMEOUT=10
STYX_ARP_MONITOR_TIMEOUT=10

# ─── LOGGING ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# ─── RATE LIMITING ────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_STRICT=30/minute

# ─── FEATURE FLAGS ────────────────────────────────────────────────────
ENABLE_WEBSOCKET=true
ENABLE_DOCS=true
ENABLE_OPENAPI=true

# ─── HUGGING FACE ─────────────────────────────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ─── ANTHROPIC CLAUDE (Optional) ────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LOCAL LLM (Ollama / LM Studio) ────────────────────────────────
# LOCAL_LLM_URL=http://localhost:11434/api/generate
# LOCAL_LLM_MODEL=qwen2.5:1.5b

# ─── PRODUCTION MODE ─────────────────────────────────────────────────
# PRODUCTION=false
# DEBUG=true